<?xml version="1.0" encoding="utf-8" ?>
<manifest>
  <control namespace="KK" constructor="NumberFormat" version="0.0.1" display-name-key="Number Format" description-key="Displays a whole number with a thousands separator configured per column: the user's own, none, or any text." control-type="virtual" >
    <external-service-usage enabled="false">
    </external-service-usage>
    <property name="value" display-name-key="Value" description-key="Whole number column to display" of-type="Whole.None" usage="bound" required="true" />
    <property name="separatorMode" display-name-key="Thousands separator" description-key="user = follow the user's number format; none = no separator; custom = use the text below" of-type="Enum" usage="input" required="false" default-value="user">
      <value name="user" display-name-key="User settings">user</value>
      <value name="none" display-name-key="None">none</value>
      <value name="custom" display-name-key="Custom text">custom</value>
    </property>
    <property name="groupSeparator" display-name-key="Custom separator" description-key="Text placed between digit groups when Thousands separator is 'custom'. Any text, emoji included." of-type="SingleLine.Text" usage="input" required="false" />
    <resources>
      <code path="index.ts" order="1"/>
      <platform-library name="React" version="16.14.0" />
      <platform-library name="Fluent" version="9.68.0" />
    </resources>
  </control>
</manifest>
